# ==========================================================
# TC-AUTH CONFIGURATION ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in your credentials.
# ==========================================================

# ==========================================================
# 1. JWT (JSON Web Tokens)
# ==========================================================
# JWT_SECRET_KEY: Strong random string (at least 32 characters).
# JWT_ALGORITHM: Algorithm for signing tokens (default: HS256).
# JWT_SESSION_DURATION_DAYS: Validity duration for single-token sessions.
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_SESSION_DURATION_DAYS=7

# ==========================================================
# 2. DUAL TOKEN ARCHITECTURE (OPTIONAL)
# ==========================================================
# Set JWT_DUAL_TOKEN_MODE=true to enable short-lived access tokens + refresh tokens.
JWT_DUAL_TOKEN_MODE=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================================
# 3. EMAIL (SMTP & OTP)
# ==========================================================
# Configure your SMTP credentials for OTP and magic link emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-smtp-app-password
EMAIL_SENDER=your-email@gmail.com
EMAIL_USE_TLS=true

# ==========================================================
# 4. GOOGLE OAUTH (OPTIONAL)
# ==========================================================
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/tc-auth/google/callback

# ==========================================================
# 5. GITHUB OAUTH (OPTIONAL)
# ==========================================================
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/tc-auth/github/callback

# ==========================================================
# 6. DISCORD OAUTH (OPTIONAL)
# ==========================================================
# Create at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/tc-auth/discord/callback

# ==========================================================
# 7. COOKIE CONFIGURATION (OPTIONAL)
# ==========================================================
# Set COOKIE_MODE=true to attach HttpOnly authentication cookies.
# COOKIE_SECURE: Set to true in production (HTTPS).
# COOKIE_SAMESITE: lax, strict, or none (if 'none', COOKIE_SECURE must be true).
COOKIE_MODE=false
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=

# ==========================================================
# 8. LOGGING CONFIGURATION
# ==========================================================
# LOGGING: Master toggle for logging system (default: true).
# When disabled, SDK logging calls are no-ops and all /log APIs return 400 'logging_disabled'.
# LOG_DIR: Directory for log files (default: 'logs/').
# LOG_STATIC_MOUNT: If true, exposes physical logs at GET /logs/*.
# LOG_LEVEL: Minimum threshold (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# LOG_CONSOLE_OUTPUT: Echo application JSONL events to terminal.
# LOG_CAPTURE_TERMINAL: Capture all process-level print() outputs to server.log.
# LOG_REDACT_SENSITIVE: Automatically redact tokens, passwords, cookies.
# LOG_REDACT_PATTERNS: JSON array of custom regular expressions to mask in logs and prints.
LOGGING=true
LOG_DIR=logs
LOG_STATIC_MOUNT=false
LOG_LEVEL=INFO
LOG_CONSOLE_OUTPUT=true
LOG_CAPTURE_TERMINAL=false
LOG_REDACT_SENSITIVE=true
LOG_REDACT_PATTERNS=[]
