# ==========================================================
# TC-AUTH CONFIGURATION TEMPLATE (.env.example)
#
# QUICK START GUIDE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your secrets, SMTP, OAuth, and cookie settings.
# 3. Import in code: from config import config
# ==========================================================


# ==========================================================
# 1. JWT (JSON WEB TOKENS)
# ==========================================================
# JWT_SECRET_KEY: Secret string for signing tokens (min 32 chars).
# JWT_ALGORITHM: Signature algorithm (default: HS256).
# JWT_SESSION_DURATION_DAYS: Lifetime for single-token sessions.
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_SESSION_DURATION_DAYS=7


# ==========================================================
# 2. DUAL TOKEN ARCHITECTURE (OPTIONAL)
# ==========================================================
# Set true to use short-lived access tokens + refresh tokens.
JWT_DUAL_TOKEN_MODE=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ==========================================================
# 3. EMAIL (SMTP & OTP)
# ==========================================================
# SMTP credentials for sending OTP codes and verification links.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-smtp-app-password
EMAIL_SENDER=your-email@gmail.com
EMAIL_USE_TLS=true


# ==========================================================
# 4. GOOGLE OAUTH (OPTIONAL)
# ==========================================================
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/tc-auth/google/callback


# ==========================================================
# 5. GITHUB OAUTH (OPTIONAL)
# ==========================================================
# Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/tc-auth/github/callback


# ==========================================================
# 6. DISCORD OAUTH (OPTIONAL)
# ==========================================================
# Portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/tc-auth/discord/callback


# ==========================================================
# 7. COOKIE CONFIGURATION (OPTIONAL)
# ==========================================================
# Set COOKIE_MODE=true to use HttpOnly authentication cookies.
# COOKIE_SECURE: Set true in production (HTTPS).
# COOKIE_SAMESITE: lax, strict, or none (if 'none', COOKIE_SECURE must be true).
COOKIE_MODE=false
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=


# ==========================================================
# 8. LOGGING CONFIGURATION
# ==========================================================
# LOGGING: Master switch for persistent logs (tcauth.log, server.log).
# LOGS_DIR: Folder path where persistent logs live.
# LOG_LEVEL: Severity filter (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# LOG_CONSOLE_OUTPUT: Show logs in console (independent of LOGGING).
# LOG_CAPTURE_TERMINAL: Capture print/stdout/stderr into server.log.
# LOG_REDACT_SENSITIVE: Auto-mask sensitive fields (passwords, tokens, cookies).
# LOG_REDACT_PATTERNS: Custom regex patterns to mask as [REDACTED].
# LOG_MAX_LOG_LINES: Max retained lines for server.log/tcauth.log.
# LOG_TRIM_LOG_LINES: Number of oldest lines removed when limit is reached.
LOGGING=true
LOGS_DIR=logs
LOG_LEVEL=INFO
LOG_CONSOLE_OUTPUT=true
LOG_CAPTURE_TERMINAL=false
LOG_REDACT_SENSITIVE=true
LOG_REDACT_PATTERNS=[]
LOG_MAX_LOG_LINES=10000
LOG_TRIM_LOG_LINES=1000
